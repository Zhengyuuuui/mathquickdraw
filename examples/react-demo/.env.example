# Copy to `.env.local` (gitignored). All of this is optional — with nothing
# set the app still draws, it just cannot persist.
#
# 8790, not wrangler's default 8787, so the API never collides with whatever
# else is running locally on 8787.
VITE_API_BASE_URL=http://127.0.0.1:8790
VITE_APP_TOKEN=change-me
